cabal-version:      3.0
name:               agda2lean
version:            0.1.0.0
synopsis:           Typed, proof-aware Agda to Lean translation infrastructure
license:            BSD-3-Clause
build-type:         Simple

flag agda-backend
    description: Build the version-pinned Agda 2.9 elaboration backend
    default: False
    manual: True
extra-source-files:
    README.md
    PLANNING.md
    ROADMAP.md
    docs/adr/0001-storage-and-canonical-encoding.md
    docs/adr/0002-elaborated-extraction-and-lean-facades.md
    cabal.project.agda-2.9
    fixtures/dashi-mirrors.toml
    lean/Agda2Lean/Manifest.lean
    schema/catalog.sql
    test/agda/Identity.agda
    test/agda/LocalRewrite.agda

common warnings
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-export-lists
        -Wpartial-fields
        -Wredundant-constraints
    default-language: GHC2021

library
    import: warnings
    hs-source-dirs: src
    exposed-modules:
        Agda2Lean.Agda.Extract
        Agda2Lean.Agda.Snapshot
        Agda2Lean.Catalog
        Agda2Lean.Classify
        Agda2Lean.Codec
        Agda2Lean.Hash
        Agda2Lean.IR
        Agda2Lean.Lean.Emit
        Agda2Lean.Mirror.Manifest
        Agda2Lean.Render
    build-depends:
        base >=4.17 && <5,
        bytestring >=0.11,
        cborg >=0.2.9,
        containers >=0.6,
        crypton >=0.33,
        file-embed >=0.0.15,
        memory >=0.18,
        mtl >=2.3,
        sqlite-simple >=0.4.19,
        text >=2.0,
        time >=1.12,
        vector >=0.13

executable agda2lean
    import: warnings
    hs-source-dirs: app
    main-is: Main.hs
    build-depends:
        agda2lean,
        base >=4.17 && <5,
        bytestring >=0.11,
        directory >=1.3,
        filepath >=1.4,
        optparse-applicative >=0.18,
        text >=2.0,
        vector >=0.13

executable agda2lean-agda
    import: warnings
    hs-source-dirs: agda-backend
    main-is: Main.hs
    if flag(agda-backend)
        buildable: True
    else
        buildable: False
    build-depends:
        Agda ==2.9.0,
        agda2lean,
        base >=4.17 && <5,
        bytestring >=0.11,
        containers >=0.6,
        directory >=1.3,
        filepath >=1.4,
        text >=2.0,
        vector >=0.13

test-suite agda2lean-test
    import: warnings
    type: exitcode-stdio-1.0
    hs-source-dirs: test
    main-is: Main.hs
    other-modules:
        AgdaFixture
        Fixture
        MirrorManifest
    build-depends:
        agda2lean,
        base >=4.17 && <5,
        bytestring >=0.11,
        containers >=0.6,
        directory >=1.3,
        filepath >=1.4,
        sqlite-simple >=0.4.19,
        tasty >=1.5,
        tasty-hunit >=0.10,
        temporary >=1.3,
        text >=2.0,
        vector >=0.13
